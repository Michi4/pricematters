# --- Traefik / routing (same pattern as your nightcrown/cuckoo setups) ---
TRAEFIK_NETWORK=traefik
ROUTER_NAME=pricematters
# ALL brand domains on ONE container. First = canonical (SEO), rest = aliases.
# (Backticks inside .env values are fine — compose expands ${ROUTER_RULE} as-is.)
ROUTER_RULE=Host(`pricematters.websters.at`) || Host(`deals.websters.at`) || Host(`dothemath.websters.at`) || Host(`moneysworth.websters.at`) || Host(`valueformoney.websters.at`) || Host(`preiswertist.websters.at`)
# Canonical host for <link rel=canonical> + og:url (avoids duplicate-content SEO penalty)
NUXT_PUBLIC_CANONICAL_HOST=pricematters.websters.at

# --- Frontend (Nuxt) ---
FRONTEND_PORT=3000
NUXT_PUBLIC_DEFAULT_LOCALE=de-AT
NUXT_PUBLIC_AFFILIATE_TAG=websters02-21

# --- Backend (FastAPI) ---
BACKEND_PORT=8000

# --- Postgres ---
POSTGRES_USER=pricematters
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=pricematters
DB_PORT=5432

# --- Redis (PA-API / scraper cache) ---
REDIS_PORT=6379

# --- Amazon: Creators API (= PA-API 5 successor, PA-API deprecated 15.05.2026) ---
# Fill in once PartnerNet approved. Backend reads these, never the frontend.
AMAZON_PARTNER_TAG=websters02-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_MARKETPLACE=www.amazon.de
AMAZON_REGION=eu-west-1

# --- Dev provider (start coding TODAY without Amazon approval) ---
# mock | scrapingbee | rainforest | serpapi | creators
DATA_PROVIDER=mock
RAINFOREST_API_KEY=
SCRAPINGBEE_API_KEY=
KEEPA_API_KEY=
SERPAPI_API_KEY=

# --- AI fallback (Gemini free tier, only for titles regex can't parse) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Self-scrape experiment (OFF unless you opt in, see backend/selfscrape.py) ---
SELFSCRAPE_CONSENT=
SELFSCRAPE_DAILY_BUDGET=50
# Your private proxies (tried FIRST, before free pools):
# Webshare free: 10 proxies + 1GB/mo at webshare.io -> "user:pass@host:port,..."
WEBSHARE_PROXIES=
# IPVanish SOCKS5 (reset creds after sharing!): user/pass + host
IPVANISH_USER=
IPVANISH_PASS=
IPVANISH_HOST=fra.socks.ipvanish.com:1080

# --- All-stores: Awin feeds (free publisher account, nightly CSV import) ---
# DATABASE_URL is auto-built in compose; for local runs set it manually, e.g.:
# DATABASE_URL=postgresql://pricematters:secret@localhost:5432/pricematters
AWIN_PUBLISHER_ID=
AWIN_ADVERTISER_IDS=
FEED_SHOP=awin
FEED_URLS=
